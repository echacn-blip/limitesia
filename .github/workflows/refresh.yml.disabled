# Plantilla (inactiva hasta que el repo exista en GitHub). Refresca y publica en GitHub Pages cada día.
name: refresh
on:
  schedule: [{cron: "0 11 * * *"}]   # 07:00 hora de Nueva York (EDT)
  workflow_dispatch: {}
permissions: {contents: write, pages: write, id-token: write}
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.12"}
      - run: SITE_URL=${{ vars.SITE_URL }} ./run.sh
      - run: |
          git config user.name "limitesia-bot"; git config user.email "bot@users.noreply.github.com"
          git add data && git commit -m "datos: refresco diario" || echo "sin cambios"
          git push
      - uses: actions/upload-pages-artifact@v3
        with: {path: site}
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment: {name: github-pages}
    steps:
      - uses: actions/deploy-pages@v4
